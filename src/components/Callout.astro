---
interface Props {
  type?: 'note' | 'tip' | 'warn';
}
const { type = 'note' } = Astro.props;
const styles = {
  note: 'border-blue-500 bg-blue-50 dark:bg-blue-950/30',
  tip:  'border-green-500 bg-green-50 dark:bg-green-950/30',
  warn: 'border-amber-500 bg-amber-50 dark:bg-amber-950/30',
};
---

<aside class={`my-6 px-4 py-3 border-l-4 rounded-r ${styles[type]}`}>
  <slot />
</aside>
