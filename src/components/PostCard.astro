---
import type { CollectionEntry } from 'astro:content';
import { type Lang } from '../consts';
import { postUrl } from '../i18n/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const locale = lang === 'zh' ? 'zh-CN' : 'en-US';
const dateStr = pubDate.toLocaleDateString(locale, {
  year: 'numeric', month: '2-digit', day: '2-digit',
});
---

<article class="py-6 border-b border-[var(--border)] last:border-0">
  <a href={postUrl(post)} class="group block">
    <h2 class="text-xl font-semibold tracking-tight group-hover:text-[var(--accent)] transition-colors">
      {title}
    </h2>
    {description && (
      <p class="mt-2 text-[var(--muted)] line-clamp-2">{description}</p>
    )}
    <div class="mt-3 flex items-center gap-3 text-sm text-[var(--muted)]">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {tags.length > 0 && (
        <span class="flex gap-2 flex-wrap">
          {tags.slice(0, 3).map(tag => (
            <span class="text-xs px-2 py-0.5 rounded bg-[var(--border)]">{tag}</span>
          ))}
        </span>
      )}
    </div>
  </a>
</article>
